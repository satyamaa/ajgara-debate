generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =========================
// ENUMS
// =========================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum EditionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum RoundStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum ParticipantStatus {
  REGISTERED
  QUALIFIED
  ELIMINATED
  WINNER
}

enum QuestionStatus {
  PENDING
  APPROVED
  REJECTED
  FEATURED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

// =========================
// ADMIN USERS
// =========================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts        Post[]

  @@index([role])
  @@index([isActive])
}

// =========================
// EDITIONS
// Example: 2026, 2027, 2028
// =========================

model Edition {
  id          String        @id @default(cuid())
  year        Int           @unique
  title       String
  slug        String        @unique
  description String?
  status      EditionStatus @default(DRAFT)

  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rounds      Round[]
  participants Participant[]
  questions   Question[]
  submissions QuestionSubmission[]
  posts       Post[]
  media       Media[]

  @@index([status])
}

// =========================
// DEBATE ROUNDS
// =========================

model Round {
  id          String      @id @default(cuid())
  editionId   String
  name        String
  slug        String
  description String?
  roundNumber Int
  status      RoundStatus @default(UPCOMING)

  startDate   DateTime?
  endDate     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition     Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  participants Participant[]

  @@unique([editionId, roundNumber])
  @@unique([editionId, slug])
  @@index([editionId])
  @@index([status])
}

// =========================
// PARTICIPANTS
// =========================

model Participant {
  id          String            @id @default(cuid())
  editionId   String
  roundId     String?

  name        String
  slug        String
  village     String?
  block       String?
  district    String?
  photoUrl    String?
  bio         String?
  score       Float?
  status      ParticipantStatus @default(REGISTERED)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition     Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  round       Round?  @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([editionId, slug])
  @@index([editionId])
  @@index([roundId])
  @@index([status])
}

// =========================
// APPROVED / PUBLISHED QUESTIONS
// =========================

model Question {
  id          String         @id @default(cuid())
  editionId   String

  question   String
  answer     String?
  theme      String?
  source     String?
  status     QuestionStatus @default(PENDING)
  isFeatured  Boolean       @default(false)

  submittedBy String?
  approvedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition     Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([status])
  @@index([isFeatured])
}

// =========================
// PUBLIC QUESTION SUBMISSIONS
// "Aaj Ka Yaksh"
// =========================

model QuestionSubmission {
  id          String         @id @default(cuid())
  editionId   String

  name        String?
  mobile      String?
  email       String?
  district    String?
  question    String
  theme       String?

  status      QuestionStatus @default(PENDING)
  isFeatured  Boolean       @default(false)

  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition     Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([status])
  @@index([createdAt])
}

// =========================
// NEWS / UPDATES / POSTS
// =========================

model Post {
  id          String     @id @default(cuid())
  editionId   String?
  authorId    String?

  title       String
  slug        String     @unique
  excerpt     String?
  content     String
  coverImage  String?

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([authorId])
  @@index([status])
  @@index([publishedAt])
}

// =========================
// MEDIA
// =========================

model Media {
  id          String    @id @default(cuid())
  editionId   String?

  title       String
  description String?
  url         String
  thumbnail   String?
  type        MediaType @default(IMAGE)
  altText     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([type])
}

// =========================
// STATIC PAGES
// About, Contact, Ajgara Story etc.
// =========================

model Page {
  id          String   @id @default(cuid())

  title       String
  slug        String   @unique
  content     String
  metaTitle   String?
  metaDescription String?

  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
}

// =========================
// WEBSITE SETTINGS
// =========================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}